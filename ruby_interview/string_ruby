7: Check angrams.
 
str1 = "listen"
str2 = "silent"

if str1.length != str2.length
  puts "Not Anagram"
  exit
end

count1 = {}
count2 = {}

str1.each_char do |char|
  if count1[char]
    count1[char] += 1
  else
    count1[char] = 1
  end
end

str2.each_char do |char|
  if count2[char]
    count2[char] += 1
  else
    count2[char] = 1
  end
end

is_anagram = true

count1.each do |char, count|
  if count2[char] != count
    is_anagram = false
    break
  end
end

if is_anagram
  puts "Anagram"
else
  puts "Not Anagram"
end


8: Find longest substring without repeating.

a = "abcabcbb"
max_len = 0
longest = ""

(0...a.length).each do |i|
    temp = ""

    (i...a.length).each do |j|
        if temp.include?(a[j])
            break
        end
        temp += a[j]

        if temp.length > max_len
           max_len = temp.length
           longest = temp
        end    
    end
end

puts longest


