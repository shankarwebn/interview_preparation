4: Count number of vowels and consonants.
vowel_chars = "aeiouAEIOU"

str = "Hello World"

vowels = 0
consonants = 0

str.each_char do |char|
  if char.match?(/[aeiouAEIOU]/)
    vowels += 1
  elsif char.match?(/[a-zA-Z]/)
    consonants += 1
  end
end

puts "Vowels: #{vowels}"
puts "Consonants: #{consonants}"


